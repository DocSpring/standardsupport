#!/usr/bin/env bash
# Renders og/og.html to src/og.png (1200x630) with headless Chrome.
set -euo pipefail
cd "$(dirname "$0")"
chrome="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
"$chrome" --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 \
  --virtual-time-budget=3000 --screenshot="$PWD/../src/og.png" "file://$PWD/og.html" >/dev/null 2>&1
echo "Wrote site/src/og.png"
